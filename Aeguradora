import abc

# Excepciones para la validación robusta
class EdadInvalidaError(Exception):
    pass

class SumaAseguradaInvalidaError(Exception):
    pass

class OpcionInvalidaError(Exception):
    pass

class TasaCambioInvalidaError(Exception):
    pass


# Aplicamos el principio Open/Closed para los factores de edad
class FactorEdadStrategy(abc.ABC):
    @abc.abstractmethod
    def obtener_factor(self, edad: int) -> float:
        pass


class FactorFemenino(FactorEdadStrategy):
    def obtener_factor(self, edad: int) -> float:
        # Tabla de factores para mujeres
        if 18 <= edad < 25: return 1.5
        if 25 <= edad < 45: return 1.7
        if 45 <= edad < 65: return 2.0
        if 65 <= edad <= 99: return 2.2
        return 0.0


class FactorMasculino(FactorEdadStrategy):
    def obtener_factor(self, edad: int) -> float:
        # Tabla de factores para hombres
        if 18 <= edad < 25: return 2.0
        if 25 <= edad < 45: return 2.3
        if 45 <= edad < 65: return 2.5
        if 65 <= edad <= 99: return 3.0
        return 0.0


# Simulador del servicio externo para el cambio de moneda
class ConversorMoneda:
    def __init__(self, tasa=21.13):
        if tasa <= 0:
            raise TasaCambioInvalidaError("La tasa de cambio no puede ser negativa o cero.")
        self.tasa = tasa

    def mxn_a_usd(self, pesos):
        return pesos / self.tasa


class Asegurado:
    # Inyectamos la estrategia (DIP) desde afuera para no acoplar la clase
    def __init__(self, sa, edad, fuma, sexo, extra_prima, estrategia_factor):
        self.sa = sa
        self.edad_original = edad
        self.fuma = fuma
        self.sexo = sexo
        self.extra_prima = extra_prima
        self.estrategia_factor = estrategia_factor
        
        self.edad_ajustada = self._calcular_edad()
        
    def _calcular_edad(self):
        edad = self.edad_original
        if self.fuma == "No": edad -= 5
        if self.sexo == 'F': edad -= 10
        if self.extra_prima == "Si": edad += 10
        
        # La edad nunca puede salir de 18 a 99
        return max(18, min(edad, 99))

    def calcular_prima(self):
        k = self.estrategia_factor.obtener_factor(self.edad_ajustada)
        return (self.sa * k) / 1000


def pedir_datos_asegurado():
    # Ciclo while para pedir datos hasta que sean válidos
    while True:
        try:
            sa = float(input("Suma asegurada (500,000 - 3,000,000): "))
            if sa < 500000 or sa > 3000000:
                raise SumaAseguradaInvalidaError("El monto está fuera del rango permitido.")
            
            edad = int(input("Edad (18-99): "))
            if edad < 18 or edad > 99:
                raise EdadInvalidaError("La edad tiene que estar entre 18 y 99.")
            
            sexo = input("Sexo (M/F): ").strip().upper()
            if sexo not in ['M', 'F']:
                raise OpcionInvalidaError("Ingresa solamente M o F.")
                
            fuma = input("¿Fuma? (Si/No): ").strip().capitalize()
            if fuma not in ["Si", "No"]:
                raise OpcionInvalidaError("Responde Si o No.")
                
            ep = input("¿Extra-prima? (Si/No): ").strip().capitalize()
            if ep not in ["Si", "No"]:
                raise OpcionInvalidaError("Responde Si o No.")
            
            # Decidimos qué estrategia usar antes de crear al asegurado
            estrategia = FactorFemenino() if sexo == 'F' else FactorMasculino()
            return Asegurado(sa, edad, fuma, sexo, ep, estrategia)
            
        except ValueError:
            print("Error: Ingresaste letras donde iba un número. Intenta de nuevo.")
        except Exception as e:
            print(f"Error en los datos: {e}. Vamos a repetirlo.")


def main():
    try:
        n_asegurados = int(input("¿Cuántos asegurados vas a registrar? "))
    except ValueError:
        print("Por favor, ingresa un número entero válido.")
        return

    # Si ingresan 0 o negativos, cortamos para no tener división entre cero luego
    if n_asegurados <= 0:
        print("Lote vacío. Terminando el programa.")
        return

    lista_asegurados = []
    conversor = ConversorMoneda()
    
    for i in range(n_asegurados):
        print(f"\n--- Asegurado {i + 1} ---")
        lista_asegurados.append(pedir_datos_asegurado())

    # Lista con los valores de las primas calculadas
    primas = [aseg.calcular_prima() for aseg in lista_asegurados]
    
    prima_promedio = sum(primas) / len(primas)
    prima_max = max(primas)
    prima_min = min(primas)
    
    # Filtramos los que tienen extra-prima para buscar al mayor
    asegurados_con_ep = [a for a in lista_asegurados if a.extra_prima == "Si"]
    if asegurados_con_ep:
        mayor_ep = max(asegurados_con_ep, key=lambda a: a.calcular_prima())
    else:
        mayor_ep = None

    print("\n--- REPORTE FINAL ---")
    print(f"Prima promedio: ${prima_promedio:,.2f} MXN")
    print(f"Prima máxima: ${prima_max:,.2f} MXN")
    print(f"Prima mínima: ${prima_min:,.2f} MXN")
    
    if mayor_ep:
        print(f"Prima más alta (con Extra-Prima): ${mayor_ep.calcular_prima():,.2f} MXN")
    
    # Bloque try/except para guardar el archivo txt con los resultados
    nombre_archivo = "carnets_asegurados.txt"
    try:
        with open(nombre_archivo, "w", encoding="utf-8") as archivo:
            for i in range(len(lista_asegurados)):
                aseg = lista_asegurados[i]
                p_mxn = primas[i]
                p_usd = conversor.mxn_a_usd(p_mxn)
                
                texto = (f"Asegurado {i+1} | Edad: {aseg.edad_original} | Sexo: {aseg.sexo} | "
                         f"Fuma: {aseg.fuma} | EP: {aseg.extra_prima} | SA: ${aseg.sa:,.2f} | "
                         f"Prima MXN: ${p_mxn:,.2f} | Prima USD: ${p_usd:,.2f}\n")
                archivo.write(texto)
        print(f"\nListo. Los datos se exportaron correctamente en '{nombre_archivo}'")
    except IOError:
        print("Hubo un error al intentar escribir el archivo en el disco.")


if __name__ == "__main__":
    main()

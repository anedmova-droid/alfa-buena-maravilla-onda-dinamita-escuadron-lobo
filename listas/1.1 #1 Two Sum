# Complejidad temporal: O(n)
# Complejidad espacial: O(n)
# Justificación: se recorre la lista una sola vez y el diccionario
# puede llegar a guardar n elementos.

class Solution(object):
    def twoSum(self, nums, target):
        # Esta es nuestra "libreta" donde anotamos los números que ya revisamos
        libreta = {} 
        
        for posicion_actual, numero_actual in enumerate(nums):
            # Hacemos el cálculo mental: ¿Qué número necesito para llegar al objetivo?
            pareja_buscada = target - numero_actual
            
            # Revisamos si ya tenemos anotada a esa pareja en nuestra libreta
            if pareja_buscada in libreta:
                posicion_de_la_pareja = libreta[pareja_buscada]
                # ¡Los encontramos! Devolvemos la posición del que estaba en la libreta y el actual
                return [posicion_de_la_pareja, posicion_actual]
            
            # Si no hemos visto a su pareja aún, anotamos este número y su posición en la libreta
            libreta[numero_actual] = posicion_actual

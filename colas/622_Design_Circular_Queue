# Complejidad temporal:  enQueue: O(1), deQueue: O(1), Front: O(1), Rear: O(1), isEmpty: O(1), isFull: O(1)
# Complejidad espacial: O(k)
# Justificación:  se utiliza un arreglo de tamaño fijo k con punteros de inicio y tamaño actual, 
# permitiendo realizar todas las operaciones en tiempo constante O(1) sin reasignación de memoria.

class MyCircularQueue:

    def __init__(self, k: int):
        self.queue = [0] * k
        self.capacity = k
        self.head = 0
        self.size = 0

    def enQueue(self, value: int) -> bool:
        if self.isFull():
            return False
        tail = (self.head + self.size) % self.capacity
        self.queue[tail] = value
        self.size += 1
        return True

    def deQueue(self) -> bool:
        if self.isEmpty():
            return False
        self.head = (self.head + 1) % self.capacity
        self.size -= 1
        return True

    def Front(self) -> int:
        if self.isEmpty():
            return -1
        return self.queue[self.head]

    def Rear(self) -> int:
        if self.isEmpty():
            return -1
        tail = (self.head + self.size - 1) % self.capacity
        return self.queue[tail]

    def isEmpty(self) -> bool:
        return self.size == 0

    def isFull(self) -> bool:
        return self.size == self.capacity
